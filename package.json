{
  "name": "designferri-crm",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:demo": "turbo dev --filter=@crm/demo",
    "crm:new": "node tools/create-crm.mjs",
    "crm:user:create": "go run ./apps/demo/server app-user create --dir=./apps/demo/server/pb_data",
    "crm:demo:seed": "go run ./apps/demo/server demo-seed --dir=./apps/demo/server/pb_data",
    "test": "node --test tools/create-crm.test.mjs && turbo test && go test ./...",
    "test:e2e": "pnpm --filter @crm/demo test:e2e",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <25"
  }
}
